{
  "manifest_version": 3,
  "name": "Miro Tab Bridge (read-only probe)",
  "version": "0.1.2",
  "description": "Read-only tab discovery for Miro experiments. No DOM read, no write.",
  "permissions": ["tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:18767/*",
                       "https://www.tiktok.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Miro Tab Bridge",
    "default_popup": "popup.html"
  }
}
